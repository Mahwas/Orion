{
    "manifest_version": 3,
    "name": "Orion Analyst",
    "version": "1.0",
    "description": "Analyze your potential purchases with the Orion Agent.",
    "action": {
        "default_popup": "popup.html",
        "default_title": "Analyze Purchase"
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost:8000/*"
    ]
}